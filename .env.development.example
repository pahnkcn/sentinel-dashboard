# Safe local defaults. Start the Auth and Firestore emulators before `npm run dev`.
VITE_FIREBASE_API_KEY=demo-public-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-sentinel-dashboard.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-sentinel-dashboard
VITE_FIREBASE_STORAGE_BUCKET=demo-sentinel-dashboard.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:0000000000000000
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_USE_EMULATORS=true
