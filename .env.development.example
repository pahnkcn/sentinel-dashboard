# Safe local defaults. Start only the Firestore emulator before the Vite/Vercel
# development server. The OAuth client must allow the exact origin
# http://localhost:3000. Do not open the app through 127.0.0.1.
VITE_GOOGLE_CLIENT_ID=replace-with-local-google-oauth-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=replace-with-local-google-oauth-web-client-id.apps.googleusercontent.com
SESSION_SECRET=replace-with-a-local-random-secret-of-at-least-32-bytes

GCP_PROJECT_ID=demo-sentinel-dashboard
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Optional local Sentinel Analyst configuration. Never commit a real key.
OPENROUTER_MODEL=z-ai/glm-5.2
OPENROUTER_SITE_URL=http://localhost:3000
