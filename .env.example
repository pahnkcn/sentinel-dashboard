# Production/staging template. Replace every placeholder before building.
# Firebase web values and the App Check site key are public browser metadata.
VITE_FIREBASE_API_KEY=replace-with-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id
VITE_FIREBASE_APPCHECK_SITE_KEY=replace-with-recaptcha-enterprise-site-key
VITE_FIREBASE_USE_EMULATORS=false
