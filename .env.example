# Public browser configuration. This value is embedded in the Vite bundle.
VITE_GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id.apps.googleusercontent.com

# Server-only Google Identity Services and session configuration.
GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id.apps.googleusercontent.com
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Firestore read-only runtime identity. Vercel supplies its OIDC token at runtime;
# never create or upload a service-account JSON key.
GCP_PROJECT_ID=replace-with-google-cloud-project-id
GCP_PROJECT_NUMBER=replace-with-google-cloud-project-number
GCP_SERVICE_ACCOUNT_EMAIL=sentinel-vercel-reader@replace-with-google-cloud-project-id.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=replace-with-vercel-workload-identity-pool-id
GCP_WORKLOAD_IDENTITY_PROVIDER_ID=replace-with-vercel-workload-identity-provider-id

# Server-only Sentinel Analyst configuration.
OPENROUTER_MODEL=z-ai/glm-5.2
OPENROUTER_SITE_URL=https://replace-with-production-host.example

# OPENROUTER_API_KEY is intentionally not assigned in this tracked template.
# Add it as a Vercel encrypted environment variable scoped to Production only.
# VERCEL_OIDC_TOKEN is issued automatically and must not be entered manually.
