# Copy to .env.<firebase-project-id> for a reviewed remote deployment.
# These are server-only Functions parameters and must never use a VITE_ prefix.
OPENROUTER_MODEL=z-ai/glm-5.2
OPENROUTER_SITE_URL=https://replace-with-approved-host.example

# Store OPENROUTER_API_KEY in Firebase Secret Manager instead of this file:
# firebase functions:secrets:set OPENROUTER_API_KEY --project <project-id>
